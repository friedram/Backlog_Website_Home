---
// Slow-crossfading hero built from the physical collection (gallery
// entries flagged hero: true) — see site-redesign-proposal.md's Home
// section. JS-driven active-class crossfade (not pure CSS): each slide
// is .hero-slide, the current one gets .is-active, and a small inline
// script (same pattern as BaseLayout's theme-toggle script) advances a
// setInterval timer and swaps the class. This replaces the old
// @keyframes-per-slide approach specifically so the dots can be real,
// clickable <button> elements — you can't click "into" a specific
// offset of a running CSS animation, but jumping to an index and
// restarting a JS timer is trivial. Autoplay is skipped entirely for
// prefers-reduced-motion, since there's no animation-duration trick
// left to rely on for that (see the script below).
import { galleryImageSrc } from "../lib/site";
import type { CollectionEntry } from "astro:content";

interface Props {
  slides: CollectionEntry<"gallery">[];
}
const { slides } = Astro.props;
const n = slides.length;
---
{n > 0 && (
  <div class="hero-rotator" data-hero-rotator data-count={n}>
    {slides.map((slide, i) => (
      <figure class="hero-slide" class:list={{ "is-active": i === 0 }} data-index={i}>
        <img src={galleryImageSrc(slide.data.image)} alt={slide.data.caption ?? "From the collection"} loading={i === 0 ? "eager" : "lazy"} />
        <figcaption>
          <div class="wrap">
            <span class="hero-rotator-eyebrow">From the collection</span>
            {slide.data.caption && <span class="hero-rotator-caption">{slide.data.caption}</span>}
          </div>
        </figcaption>
      </figure>
    ))}
    {n > 1 && (
      <div class="hero-rotator-dots">
        {slides.map((slide, i) => (
          <button
            type="button"
            class="hero-dot"
            class:list={{ "is-active": i === 0 }}
            data-index={i}
            aria-label={`Show slide ${i + 1}${slide.data.caption ? `: ${slide.data.caption}` : ""}`}
            aria-current={i === 0 ? "true" : "false"}
          ></button>
        ))}
      </div>
    )}
  </div>
)}
{n > 1 && (
  <script is:inline>
    (function () {
      var roots = document.querySelectorAll("[data-hero-rotator]");
      roots.forEach(function (root) {
        var slides = Array.prototype.slice.call(root.querySelectorAll(".hero-slide"));
        var dots = Array.prototype.slice.call(root.querySelectorAll(".hero-dot"));
        var current = 0;
        var timer = null;
        var AUTOPLAY_MS = 7000;
        var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function show(index) {
          current = (index + slides.length) % slides.length;
          slides.forEach(function (slide, i) {
            slide.classList.toggle("is-active", i === current);
          });
          dots.forEach(function (dot, i) {
            var active = i === current;
            dot.classList.toggle("is-active", active);
            dot.setAttribute("aria-current", active ? "true" : "false");
          });
        }

        function stop() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        function start() {
          if (reduceMotion) return;
          stop();
          timer = setInterval(function () {
            show(current + 1);
          }, AUTOPLAY_MS);
        }

        dots.forEach(function (dot, i) {
          dot.addEventListener("click", function () {
            show(i);
            start(); // restart the autoplay clock from a manual jump
          });
        });

        start();
      });
    })();
  </script>
)}
