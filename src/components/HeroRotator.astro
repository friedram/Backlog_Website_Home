---
// Slow-crossfading hero built from the physical collection (gallery
// entries flagged hero: true) — see site-redesign-proposal.md's Home
// section. Pure CSS crossfade, no JS: every slide (image + its own
// caption, faded together as one <figure>) shares one @keyframes rule
// generated below, sized to however many slides exist, and each slide
// is offset with its own animation-delay — the standard way to stagger
// identical CSS animations across elements. tokens.css's global
// `@media (prefers-reduced-motion: reduce)` rule already zeroes every
// animation-duration sitewide, which is what freezes this on the first
// slide for anyone with that preference — nothing extra needed here.
import { galleryImageSrc } from "../lib/site";
import type { CollectionEntry } from "astro:content";

interface Props {
  slides: CollectionEntry<"gallery">[];
}
const { slides } = Astro.props;
const n = slides.length;
const perSlideSeconds = 7;
const cycleSeconds = Math.max(n, 1) * perSlideSeconds;

// One slide's visible window as a percent of the whole cycle, minus a
// short crossfade transition at each edge. Capped low (1.5%, ~0.2s on a
// 14s two-slide cycle) rather than the more typical 3-4% — each slide's
// caption is baked into the same fading element as its image (see the
// figcaption below), so a longer overlap window means two captions
// visibly double-print on top of each other for a beat. Caught this on
// a mobile screenshot, where the shorter hero leaves no room for that
// to be legible at all.
const fadePct = n > 1 ? Math.min(1.5, 100 / n / 3) : 0;
const windowPct = 100 / Math.max(n, 1);
const holdEndPct = Math.max(windowPct - fadePct, 0);

const keyframes = `
@keyframes hero-rotator-fade {
  0% { opacity: 0; }
  ${fadePct.toFixed(2)}% { opacity: 1; }
  ${holdEndPct.toFixed(2)}% { opacity: 1; }
  ${windowPct.toFixed(2)}% { opacity: 0; }
  100% { opacity: 0; }
}
@keyframes hero-rotator-dot-fade {
  0% { opacity: 0.4; }
  ${fadePct.toFixed(2)}% { opacity: 1; }
  ${holdEndPct.toFixed(2)}% { opacity: 1; }
  ${windowPct.toFixed(2)}% { opacity: 0.4; }
  100% { opacity: 0.4; }
}
`;
---
{n > 0 && (
  <div class="hero-rotator">
    <style set:html={keyframes} />
    {slides.map((slide, i) => (
      <figure
        class="hero-slide"
        style={`animation-duration:${cycleSeconds}s; animation-delay:${-(i * perSlideSeconds)}s`}
      >
        <img src={galleryImageSrc(slide.data.image)} alt={slide.data.caption ?? "From the collection"} loading={i === 0 ? "eager" : "lazy"} />
        <figcaption>
          <div class="wrap">
            <span class="hero-rotator-eyebrow">From the collection</span>
            {slide.data.caption && <span class="hero-rotator-caption">{slide.data.caption}</span>}
          </div>
        </figcaption>
      </figure>
    ))}
    {n > 1 && (
      <div class="hero-rotator-dots" aria-hidden="true">
        {slides.map((_, i) => (
          <span style={`animation-duration:${cycleSeconds}s; animation-delay:${-(i * perSlideSeconds)}s`}></span>
        ))}
      </div>
    )}
  </div>
)}
