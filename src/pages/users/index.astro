---
// "Users" hub — nav-parity pass, 2026-09-28. Same approach as Other:
// this hub page is rebuilt here, but individual profile pages (just
// GruffyGrey for now) stay on WordPress, untouched, at their existing
// URLs. Andy and Brian (added 2026-10-03) are listed as non-clickable
// placeholders with a status pill until their pages exist; turn each
// <div class="soon"> into an <a href> like GruffyGrey's when it does.
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Users" description="Other people writing about their backlogs.">
  <main class="wrap simple-page">
    <h1>Users</h1>
    <p>find users here</p>
    <nav class="subpage-links" aria-label="User profiles">
      <a href="https://deathbybacklog.com/users/gruffygrey/">
        <span class="label-block">
          GruffyGrey
          <span class="desc">Books/series I like.</span>
        </span>
        <span class="arrow">→</span>
      </a>
      <div class="soon">
        <span class="label-block">
          Andy
          <span class="desc">Profile in development.</span>
        </span>
        <span class="status-pill is-dev">In development</span>
      </div>
      <div class="soon">
        <span class="label-block">
          Brian
          <span class="desc">Profile pending.</span>
        </span>
        <span class="status-pill">Pending</span>
      </div>
    </nav>
  </main>
</BaseLayout>
