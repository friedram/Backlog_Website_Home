---
// Andy's "Xbox 25" page — a hand-authored personal retrospective for
// Xbox's 25th anniversary (November 15, 2026), nested under the Andy
// entry in Users (see BaseLayout.astro's .submenu-nested and
// users/index.astro's .subpage-links-nested). Not a live Xbox-API
// dashboard — consistent with this project's "favor maintainability,
// assume a single content creator" rule, this is a plain page Andy
// (or a future Claude session) edits by hand as he sends more data.
//
// Xbox's own feature is called the "Playback Archive." This page
// pulls real facts from Andy's own archive but is written in this
// site's own voice and built from its own dark/gold tokens.css system
// rather than cloning Xbox's green-branded UI — same "inspired by, not
// cloned" convention the rest of the site already follows.
//
// Andy's real gamertag never appears here. Everywhere this page would
// show it, it shows "Andy" instead, per his explicit request — that
// was the whole point of building this ourselves rather than just
// linking his real archive.
//
// Content status (2026-11-13, updated 2026-11-14 three times — round 4,
// round 7, and round 8): the #1 most-played game (now with its full
// stat line and Gamerscore ring), Your Origin, Your Journey (lifetime
// totals, best years, where he played, top genres), all nine "Other
// Favorites" ranks (2-10, complete as of round 8), three category
// highlights, and Your Legacy (rarest achievement, completion stats,
// percentile rings) are all confirmed from real screenshots of Andy's
// own Playback Archive. His overall achievement count across every
// game (as opposed to Fallout 76's own count) is the one remaining
// pending item — see the pending-panel below. Do not invent it; replace
// the pending-panel once he sends it.
//
// Visual treatment (2026-11-14): a full-bleed animated line backdrop
// behind the top of the page and a bold centered stat callout, matching
// the general "wrapped"-style recap energy of Xbox's own page (motion +
// a declarative headline statement) — but built entirely from this
// site's own gold/dark palette and its own line paths, not Xbox's green
// identity, logo, or literal background graphic. See tokens.css's
// .xbox25-page-wrap / .xbox25-ambient comment for the reasoning.
//
// Box art: every game's art is sourced fresh and independently from
// Xbox's own store pages / Microsoft Store image CDN, per Andy's
// explicit "real Xbox art for every game" direction (2026-11-13,
// confirmed via AskUserQuestion after an initial ambiguous "1:1 copy"
// request — he does NOT want Xbox's page design/branding/logo cloned,
// only the box art itself). Age of Empires: Castle Siege and After
// Burner Climax are the two exceptions — Castle Siege is a cropped
// promo screenshot (never had traditional packaging), and After Burner
// Climax (round 9) is cropped directly from Andy's own Playback
// Archive screenshot, since it's a delisted Xbox Live Arcade title
// with no live xbox.com store page left to source from. Both are
// Xbox's own real official art, just not reachable via a live product
// page fetch.
//
// Round 9 also added two "Your Origin" milestones (First Game Played,
// First Game with 100% Achievements Completed) and corrected two
// numbers in Your Journey (Console hours, 2026 play time) against
// Andy's own screenshots — see originMilestones below.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { withBase } from "../../../lib/site";
import { findOriginImage, listOriginExtras } from "../../../lib/originImage";

// Optional owner-chosen images for the two "Your Origin" slots — drop
// left.* / right.* into public/images/users/andy/xbox-25/origin/ (see
// that folder's README). Falls back to the built-in defaults below.
const originLeftImage = findOriginImage("andy", "left");
const originRightImage = findOriginImage("andy", "right");
const originFullImage = findOriginImage("andy", "full");
const originExtras = listOriginExtras("andy");

const boxArt = withBase("/images/users/andy/xbox-25/fallout-76.jpg");

const otherFavorites = [
  {
    rank: 2,
    title: "Diablo IV",
    image: "diablo-4.jpg",
  },
  {
    rank: 3,
    title: "DOOM: The Dark Ages",
    image: "doom-the-dark-ages.jpg",
  },
  {
    rank: 4,
    title: "Stellaris: Console Edition",
    image: "stellaris-console-edition.jpg",
  },
  {
    rank: 5,
    title: "Age of Empires: Castle Siege",
    image: "age-of-empires-castle-siege.jpg",
  },
  {
    rank: 6,
    title: "Warhammer 40,000: Rogue Trader",
    image: "warhammer-40k-rogue-trader.png",
  },
  {
    rank: 7,
    title: "Mass Effect 3",
    image: "mass-effect-3.jpg",
  },
  {
    rank: 8,
    title: "Warhammer 40,000: Darktide",
    image: "warhammer-40k-darktide.jpg",
  },
  {
    rank: 9,
    title: "Mass Effect 2",
    image: "mass-effect-2.jpg",
  },
  {
    rank: 10,
    title: "Mass Effect: Andromeda",
    image: "mass-effect-andromeda.jpg",
  },
];

// "Your Origin" milestones — first game played, first achievement
// ever unlocked, and first game fully completed (100% achievements),
// from Andy's own screenshot of that 3-up row. Sits alongside the
// origin-stats (joined date, first console) in the same section.
const originMilestones = [
  {
    label: "First Game Played",
    name: "The Orange Box",
    meta: "November 22, 2007",
    image: "the-orange-box.jpg",
    alt: "The Orange Box box art",
  },
  {
    label: "First Achievement Unlocked",
    name: "Head Collector",
    meta: "Far Cry Instincts Predator · Unlocked December 24, 2007",
    image: "far-cry-instincts-predator.jpg",
    alt: "Far Cry Instincts Predator box art",
  },
  {
    label: "First Game with 100% Achievements Completed",
    name: "After Burner Climax",
    meta: "Unlocked May 12, 2010",
    image: "after-burner-climax.jpg",
    alt: "After Burner Climax box art",
  },
];

// Fallout 76's full stat line + Gamerscore ring, from Andy's "#1 Most
// Played Game" screenshot.
const falloutStats = {
  timePlayed: "2,140h",
  gamerscore: "1,330",
  achievements: "63",
  topAchievement: "I Am Become Death",
  gamerscorePct: 84,
};

// "Your Journey" — lifetime totals and best years, from Andy's own
// screenshot of that section.
const journeyStats = [
  { label: "Total Playing Time", value: "14,259h" },
  { label: "Total Games Played", value: "1,218" },
  { label: "Top Genre", value: "Role Playing" },
];
const journeyYears = [
  { label: "Year With Most Play Time", value: "2026", sub: "2,043h" },
  { label: "Year With Highest Gamerscore", value: "2025", sub: "31,167" },
  { label: "Year With Most Games Played", value: "2025", sub: "234 games" },
];
const wherePlayed = [
  { label: "Console", hours: 10082 },
  { label: "PC", hours: 2637 },
  { label: "Mobile", hours: 429 },
  { label: "Cloud", hours: 114 },
];
const wherePlayedMax = Math.max(...wherePlayed.map((w) => w.hours));
const topGenres = [
  { label: "Role Playing", pct: 32 },
  { label: "Action & Adventure", pct: 26 },
  { label: "Shooter", pct: 23 },
  { label: "Strategy", pct: 8 },
  { label: "Other", pct: 11 },
];

// Genre pictogram (round 12, 2026-11-14): a grid of small shapes, one
// per genre, sized by percentage — the same "pieces" treatment Xbox's
// own archive page uses under Top Genres. Plain geometric shapes and a
// rounding method, nothing borrowed from Xbox's actual page beyond the
// idea of a shape-grid. One shape + one color per genre, reused for
// both the small label swatch on each bar row and the grid itself so
// they read as the same legend.
const genreShapes = ["circle", "diamond", "triangle", "square", "plus"];
const genreColors = ["var(--gold)", "var(--new)", "var(--ink)", "var(--gold-dim)", "var(--up)"];
const PICTOGRAM_TOTAL = 70;
function buildPictogram(items, total) {
  // Largest-remainder rounding so the piece counts sum to exactly
  // `total` instead of drifting from naive per-item rounding.
  const raw = items.map((it) => (it.pct / 100) * total);
  const counts = raw.map(Math.floor);
  let used = counts.reduce((a, b) => a + b, 0);
  const order = raw
    .map((r, i) => ({ i, remainder: r - counts[i] }))
    .sort((a, b) => b.remainder - a.remainder);
  let k = 0;
  while (used < total && order.length > 0) {
    counts[order[k % order.length].i] += 1;
    used += 1;
    k += 1;
  }
  const pieces = [];
  items.forEach((it, i) => {
    for (let n = 0; n < counts[i]; n++) {
      pieces.push({
        shape: genreShapes[i % genreShapes.length],
        color: genreColors[i % genreColors.length],
        label: it.label,
      });
    }
  });
  return pieces;
}
const genrePieces = buildPictogram(topGenres, PICTOGRAM_TOTAL);
const genrePictogramLabel = `Genre breakdown: ${topGenres
  .map((g) => `${g.label} ${g.pct}%`)
  .join(", ")}`;

// "Your Legacy" — rarest achievement, completion stats, and percentile
// rings, from Andy's own screenshot of that section. The rings show
// how full the circle is, not the raw "top X%" figure directly — a
// "top 0.1%" ring reads as 99.9% filled (nearly whole, tiny gap),
// matching how Xbox's own page draws it.
const legacyStats = [
  {
    label: "Rarest Achievement",
    value: "The Illustrious",
    sub: "MechWarrior 5: Clans · Unlocked June 21, 2025",
  },
  {
    label: "Games Completed",
    value: "23",
    sub: "with 100% achievements unlocked",
  },
  {
    label: "Longest Play Streak",
    value: "397 Days",
    sub: "October 10, 2025 – November 10, 2026",
  },
];
const legacyPercentiles = [
  { label: "Achievements unlocked", topPct: 0.1 },
  { label: "Gamerscore", topPct: 0.1 },
  { label: "Time played", topPct: 0.6 },
];

const highlights = [
  {
    label: "Highest Gamerscore",
    title: "Mass Effect Legendary Edition",
    image: "mass-effect-legendary-edition.jpg",
  },
  {
    label: "Highest Achievements",
    title: "Halo: The Master Chief Collection",
    image: "halo-mcc.jpg",
  },
  {
    label: "Most Sessions",
    title: 'Fallout 76 · "The Slasher"',
    image: "fallout-76.jpg",
  },
];
---
<BaseLayout
  title="Xbox 25 — Andy"
  description="Andy's personal look back at 25 years of Xbox, built from his own Xbox Playback Archive."
>
  <div class="xbox25-page-wrap">
    <div class="xbox25-ambient" aria-hidden="true">
      <svg viewBox="0 0 1600 460" preserveAspectRatio="xMidYMid slice">
        <path class="line line-a" d="M-100,260 C 250,60 650,440 1050,180 S 1850,340 2100,120" />
        <path class="line line-b" d="M-100,360 C 380,480 780,80 1180,340 S 1950,140 2200,280" />
        <path class="line line-c" d="M-100,140 C 330,340 730,140 1130,340 S 1930,200 2150,380" />
      </svg>
    </div>
    <main class="wrap simple-page xbox25-page">
    <div class="xbox25-topbar">
      <span class="kicker">Users · Andy</span>
      <button class="share-button" id="xbox25-share" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span class="share-label">Share</span>
      </button>
    </div>
    <h1>25 Years of Xbox, My Way</h1>
    <p class="lede">
      Xbox turns 25 on November 15, 2026, and to mark it they built every
      player a personal "Playback Archive" — stats and milestones pulled from
      years of play. This is Andy's version of that, with the real gamertag
      swapped out for "Andy" so it stays about the games, not the handle.
    </p>

    <div class="hero-panel xbox25-hero">
      <div class="glow" aria-hidden="true"></div>
      <div class="backdrop" style={`background-image:url(${boxArt})`}></div>
      <div class="scrim"></div>
      <div class="content">
        <img class="art" src={boxArt} alt="Fallout 76 box art" />
        <div>
          <span class="hero-eyebrow">Most played</span>
          <h2>Fallout 76</h2>
          <p class="hero-take">
            The #1 game in Andy's Playback Archive — more hours sunk into
            Appalachia than anywhere else on Xbox.
          </p>
          <div class="hero-stats">
            <div class="hero-stat">
              <span class="hero-stat-label">Total time played</span>
              <span class="hero-stat-value">{falloutStats.timePlayed}</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-label">Total Gamerscore</span>
              <span class="hero-stat-value">{falloutStats.gamerscore}</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-label">Total achievements</span>
              <span class="hero-stat-value">{falloutStats.achievements}</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-label">Top achievement</span>
              <span class="hero-stat-value">{falloutStats.topAchievement}</span>
            </div>
          </div>
          <div class="hero-ring-wrap">
            <div class="ring" style={`--pct:${falloutStats.gamerscorePct}`}>
              <span class="ring-value">{falloutStats.gamerscorePct}%</span>
            </div>
            <p class="ring-caption">
              of the possible Gamerscore earned in Fallout 76.
            </p>
          </div>
        </div>
      </div>
    </div>

    <p class="xbox25-callout">
      <strong>Fallout 76</strong> is Andy's #1 played game of all time.
    </p>

    <section class="xbox25-origin">
      <h2>Your Origin</h2>
      {originExtras.length > 0 && (
        <div class="origin-extra">
          {originExtras.map((src) => (
            <img src={src} alt="" loading="lazy" />
          ))}
        </div>
      )}
      {originFullImage ? (
        <div class="origin-full">
          <img src={originFullImage} alt="" loading="lazy" />
        </div>
      ) : (
        <div class="origin-graphic">
          <div class="origin-node">
            {originLeftImage ? (
              <div class="origin-photo">
                <img src={originLeftImage} alt="" loading="lazy" />
              </div>
            ) : (
              <div class="origin-badge" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="20.5" stroke="currentColor" stroke-width="2.5"></circle>
                  <circle cx="24" cy="24" r="12.5" stroke="currentColor" stroke-width="2.5"></circle>
                  <circle cx="24" cy="24" r="4" fill="currentColor"></circle>
                </svg>
              </div>
            )}
            <span class="hero-eyebrow">Xbox Player Since</span>
            <div class="origin-value">July 21, 2003</div>
          </div>
          <div class="origin-line" aria-hidden="true"></div>
          <div class="origin-node">
            <div class="origin-photo">
              <img
                src={originRightImage ?? withBase("/images/users/shared/xbox-original.png")}
                alt={originRightImage ? "" : "Original Xbox console with controller"}
                loading="lazy"
              />
            </div>
            <span class="hero-eyebrow">Your First Console</span>
            <div class="origin-value">Original Xbox</div>
            <a class="origin-link" href={withBase("/users/andy/original-xbox/")}>See my Original Xbox games →</a>
          </div>
        </div>
      )}
      <div class="origin-owner-tools" id="origin-owner-tools" hidden>
        <strong>Owner tools — choose your own images</strong>
        <p>
          Pick a picture for either slot above to preview it right here. Then
          use "Save as file" and put that file in the folder named in the
          README (left.png / right.png) and push, to make it live for everyone.
          Only you see this panel (it appears when the address ends in
          <code>?edit=1</code>).
        </p>
        <div class="owner-row">
          <label class="owner-btn">Choose one wide image<input type="file" accept="image/*" data-slot="full" hidden /></label>
          <a class="owner-save" data-save="full" hidden>Save as full.png</a>
          <label class="owner-btn">Choose left image<input type="file" accept="image/*" data-slot="left" hidden /></label>
          <a class="owner-save" data-save="left" hidden>Save as left.png</a>
          <label class="owner-btn">Choose right image<input type="file" accept="image/*" data-slot="right" hidden /></label>
          <a class="owner-save" data-save="right" hidden>Save as right.png</a>
        </div>
        <p id="owner-status" role="status" aria-live="polite"></p>
      </div>
      <div class="origin-milestones">
        {originMilestones.map((m) => (
          <div class="milestone-tile">
            <span class="hero-eyebrow">{m.label}</span>
            <img
              src={withBase(`/images/users/andy/xbox-25/${m.image}`)}
              alt={m.alt}
              loading="lazy"
            />
            <p class="milestone-name">{m.name}</p>
            <p class="milestone-meta">{m.meta}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="xbox25-journey">
      <h2>Your Journey</h2>
      <div class="journey-stats">
        {journeyStats.map((s) => (
          <div class="origin-stat">
            <span class="hero-eyebrow">{s.label}</span>
            <div class="origin-value">{s.value}</div>
          </div>
        ))}
      </div>
      <div class="journey-stats journey-years">
        {journeyYears.map((y) => (
          <div class="origin-stat">
            <span class="hero-eyebrow">{y.label}</span>
            <div class="origin-value">{y.value}</div>
            <div class="origin-subvalue">{y.sub}</div>
          </div>
        ))}
      </div>
      <div class="journey-split">
        <div class="journey-column">
          <h3>Where You Played</h3>
          {wherePlayed.map((w) => (
            <div class="stat-bar-row">
              <span class="stat-bar-label">{w.label}</span>
              <span class="stat-bar-track">
                <span
                  class="stat-bar-fill"
                  style={`width:${Math.round((w.hours / wherePlayedMax) * 100)}%`}
                ></span>
              </span>
              <span class="stat-bar-value">{w.hours.toLocaleString()}h</span>
            </div>
          ))}
        </div>
        <div class="journey-column">
          <h3>Top Genres</h3>
          {topGenres.map((g, i) => (
            <div class="stat-bar-row">
              <span
                class="stat-bar-swatch"
                style={`background:${genreColors[i % genreColors.length]}`}
                aria-hidden="true"
              ></span>
              <span class="stat-bar-label">{g.label}</span>
              <span class="stat-bar-track">
                <span class="stat-bar-fill" style={`width:${g.pct}%`}></span>
              </span>
              <span class="stat-bar-value">{g.pct}%</span>
            </div>
          ))}
          <div
            class="genre-pictogram"
            role="img"
            aria-label={genrePictogramLabel}
          >
            {genrePieces.map((p) => (
              <span
                class={`pictogram-piece shape-${p.shape}`}
                style={`color:${p.color}`}
                title={p.label}
              ></span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="xbox25-favorites">
      <h2>Other Favorites</h2>
      <p class="section-note">
        Ranks 2–10 as Xbox's archive listed them. Scroll or use the arrows.
      </p>
      <div class="scroll-row-wrap">
        <button class="scroll-arrow prev" type="button" aria-label="Scroll left">‹</button>
        <ul class="scroll-row" id="favorites-row">
          {otherFavorites.map((game) => (
            <li class="favorite-card">
              <img
                src={withBase(`/images/users/andy/xbox-25/${game.image}`)}
                alt={`${game.title} box art`}
                loading="lazy"
              />
              <span class="favorite-rank">{game.rank}</span>
              <span class="favorite-title">{game.title}</span>
            </li>
          ))}
        </ul>
        <button class="scroll-arrow next" type="button" aria-label="Scroll right">›</button>
      </div>
    </section>

    <section class="xbox25-highlights">
      <h2>Category Highlights</h2>
      <div class="highlight-grid">
        {highlights.map((h) => (
          <div class="highlight-tile">
            <span class="hero-eyebrow">{h.label}</span>
            <img
              src={withBase(`/images/users/andy/xbox-25/${h.image}`)}
              alt={`${h.title} box art`}
              loading="lazy"
            />
            <p class="highlight-title">{h.title}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="xbox25-legacy">
      <h2>Your Legacy</h2>
      <div class="legacy-stats">
        {legacyStats.map((s) => (
          <div class="origin-stat">
            <span class="hero-eyebrow">{s.label}</span>
            <div class="origin-value">{s.value}</div>
            <div class="origin-subvalue">{s.sub}</div>
          </div>
        ))}
      </div>
      <div class="legacy-rings">
        {legacyPercentiles.map((p) => (
          <div class="legacy-ring-tile">
            <div class="ring" style={`--pct:${100 - p.topPct}`}>
              <span class="ring-value">{p.topPct}%</span>
            </div>
            <p>
              You're in the <strong>top {p.topPct}%</strong> of players for{" "}
              {p.label}.
            </p>
          </div>
        ))}
      </div>
    </section>

    <div class="pending-panel">
      <strong>More of this story is on its way.</strong>
      <p>
        Still pending: Andy's overall achievement count across every game
        (Fallout 76's own count above is confirmed — this is the
        career-wide total). That lands here once it's been pulled
        together — nothing here is getting invented in the meantime.
      </p>
    </div>

    <a class="ogx-nextcard" href={withBase("/users/andy/original-xbox/")}>
      <span class="kicker">Keep going</span>
      <strong>The Original Xbox Shelf</strong>
      <span class="ogx-nextcopy">Every Original Xbox game I own, as a box-art wall →</span>
    </a>
    </main>
  </div>

  <script is:inline>
    (function () {
      // Owner-only picker for the "Your Origin" slots. Previews the chosen
      // image in the page and offers it as a downloadable left.png/right.png
      // (resized to <=640px) for the origin/ folder. Visitors never see it:
      // the panel stays hidden unless the address has ?edit=1.
      var panel = document.getElementById("origin-owner-tools");
      if (!panel || !/[?&]edit=1/.test(location.search)) return;
      panel.hidden = false;
      var savedBlobs = {};
      var status = document.getElementById("owner-status");
      function say(msg) { if (status) status.textContent = msg; }
      // "Save as ..." opens a real Save window (Chrome/Edge) so the file goes
      // straight into the folder you pick; other browsers fall back to a
      // normal download.
      panel.querySelectorAll(".owner-save").forEach(function (a) {
        a.addEventListener("click", function (e) {
          var slot = a.getAttribute("data-save");
          var blob = savedBlobs[slot];
          if (!blob || !window.showSaveFilePicker) {
            say("Your browser is downloading " + slot + ".png to its Downloads folder.");
            return;
          }
          e.preventDefault();
          window.showSaveFilePicker({
            id: "origin-folder",
            suggestedName: slot + ".png",
            types: [{ description: "PNG image", accept: { "image/png": [".png"] } }],
          }).then(function (handle) {
            return handle.createWritable().then(function (w) {
              return w.write(blob).then(function () { return w.close(); });
            }).then(function () {
              say("Saved " + handle.name + ". Now run the git add / commit / push commands.");
            });
          }).catch(function (err) {
            if (err && err.name === "AbortError") { say("Save cancelled — click it again and pick the folder."); return; }
            say("Could not save (" + (err && err.name) + "). Falling back to a download.");
            var tmp = document.createElement("a");
            tmp.href = URL.createObjectURL(blob);
            tmp.download = slot + ".png";
            document.body.appendChild(tmp); tmp.click(); tmp.remove();
          });
        });
      });
      var nodes = document.querySelectorAll(".origin-graphic .origin-node");
      var slots = { left: nodes[0], right: nodes[nodes.length - 1] };
      panel.querySelectorAll('input[type="file"]').forEach(function (input) {
        input.addEventListener("change", function () {
          var file = input.files && input.files[0];
          if (!file) return;
          var slot = input.getAttribute("data-slot");
          var url = URL.createObjectURL(file);
          var img = new Image();
          img.onload = function () {
            var scale = Math.min(1, (slot === "full" ? 1200 : 640) / Math.max(img.width, img.height));
            var c = document.createElement("canvas");
            c.width = Math.round(img.width * scale);
            c.height = Math.round(img.height * scale);
            c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
            var holder = document.createElement("div");
            holder.className = "origin-photo";
            var shown = document.createElement("img");
            shown.src = url;
            shown.alt = "";
            holder.appendChild(shown);
            if (slot === "full") {
              var target = document.querySelector(".origin-graphic, .origin-full");
              var wide = document.createElement("div");
              wide.className = "origin-full";
              var wideImg = document.createElement("img");
              wideImg.src = url;
              wideImg.alt = "";
              wide.appendChild(wideImg);
              target.replaceWith(wide);
            } else {
              var node = slots[slot];
              node.replaceChild(holder, node.firstElementChild);
            }
            c.toBlob(function (blob) {
              var a = panel.querySelector('[data-save="' + slot + '"]');
              a.href = URL.createObjectURL(blob);
              a.download = slot + ".png";
              a.hidden = false;
              savedBlobs[slot] = blob;
              say("Preview shown above. Now click \"Save as " + slot + ".png\" and choose the origin folder.");
            }, "image/png");
          };
          img.src = url;
        });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      // Horizontal scroll row for "Other Favorites" — plain native
      // overflow-x scrolling (works with touch/trackpad on its own;
      // the arrow buttons are just a convenience, same philosophy as
      // the hero rotator's dots: simple, no extra library).
      var row = document.getElementById("favorites-row");
      if (!row) return;
      var prev = document.querySelector(".scroll-arrow.prev");
      var next = document.querySelector(".scroll-arrow.next");

      // Step by exactly one card (its full width plus the row's gap),
      // not a fraction of the whole row — so each arrow click advances
      // the list one game at a time instead of jumping several cards
      // at once. Measured from the actual rendered cards (the gap
      // between the first two) so it stays correct if the card size or
      // gap ever changes, rather than a hardcoded pixel value.
      function cardStep() {
        var first = row.querySelector(".favorite-card");
        if (!first) return row.clientWidth;
        var second = first.nextElementSibling;
        if (second) return second.offsetLeft - first.offsetLeft;
        return first.getBoundingClientRect().width;
      }
      function scrollByAmount(dir) {
        row.scrollBy({ left: cardStep() * dir, behavior: "smooth" });
      }
      if (prev) prev.addEventListener("click", function () { scrollByAmount(-1); });
      if (next) next.addEventListener("click", function () { scrollByAmount(1); });

      // The arrows only mean anything once the row actually has more
      // content than fits — with just a handful of cards the row is
      // narrower than its wrapper, so an arrow pinned to the wrapper's
      // edge floats past the last real card instead of sitting next to
      // it, and clicking it does nothing because there's nothing left
      // to scroll to. Hide both arrows until the row genuinely
      // overflows (more favorites land, or the viewport narrows), and
      // recheck on resize since that can flip either way.
      function updateArrowVisibility() {
        var scrollable = row.scrollWidth > row.clientWidth + 1;
        if (prev) prev.style.display = scrollable ? "" : "none";
        if (next) next.style.display = scrollable ? "" : "none";
      }
      updateArrowVisibility();
      window.addEventListener("resize", updateArrowVisibility);
    })();
  </script>

  <script is:inline>
    (function () {
      // Real share button: uses the Web Share sheet where the browser
      // supports it (most mobile browsers, some desktop ones), falls
      // back to copying the page URL to the clipboard otherwise — not
      // a decorative button, it actually does something either way.
      var btn = document.getElementById("xbox25-share");
      if (!btn) return;
      var label = btn.querySelector(".share-label");
      function flash(text) {
        if (!label) return;
        var original = label.textContent;
        label.textContent = text;
        btn.classList.add("is-done");
        setTimeout(function () {
          label.textContent = original;
          btn.classList.remove("is-done");
        }, 1800);
      }
      btn.addEventListener("click", async function () {
        var shareData = {
          title: document.title,
          text: "Andy's 25 years of Xbox, told through his own play — on Death By Backlog.",
          url: window.location.href,
        };
        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {
            // User backed out of the share sheet — not an error.
          }
          return;
        }
        try {
          await navigator.clipboard.writeText(window.location.href);
          flash("Copied!");
        } catch (e) {
          // No Web Share API and no clipboard access — nothing more
          // we can do without a server-side share endpoint, which
          // this static, single-creator site deliberately doesn't have.
        }
      });
    })();
  </script>
</BaseLayout>
